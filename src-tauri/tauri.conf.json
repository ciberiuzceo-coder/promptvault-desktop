{
  "productName": "PromptVault",
  "version": "0.1.0",
  "identifier": "com.promptvault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PromptVault",
        "width": 480,
        "height": 680,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "global-shortcut": null,
    "store": null
  }
}
